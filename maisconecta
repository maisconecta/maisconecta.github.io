<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Conecta+ | Minha comunicação, minha voz!</title>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&family=Nunito:wght@600;700;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
:root{--bg:#FFF8EC;--sf:#fff;--sf2:#FFF1D6;--tx:#14213D;--tx2:#4A5675;--bd:#E9DCC0;--br:#1E3A8A;--brt:#fff;--fc:#2563EB;--sh:0 6px 0 rgba(30,58,138,.14);box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme]){--bg:#0B1226;--sf:#16203D;--sf2:#1D2A4F;--tx:#F4F7FF;--tx2:#C3CCE6;--bd:#2E3C66;--br:#5B8CFF;--brt:#07102B;--fc:#8FB0FF;--sh:0 6px 0 rgba(0,0,0,.35)}}
:root[data-theme=light]{}
:root[data-theme=dark]{--bg:#0B1226;--sf:#16203D;--sf2:#1D2A4F;--tx:#F4F7FF;--tx2:#C3CCE6;--bd:#2E3C66;--br:#5B8CFF;--brt:#07102B;--fc:#8FB0FF;--sh:0 6px 0 rgba(0,0,0,.35)}
:root[data-theme=contrast]{--bg:#000;--sf:#000;--sf2:#111;--tx:#FFEB00;--tx2:#fff;--bd:#FFEB00;--br:#FFEB00;--brt:#000;--fc:#00FFFF;--sh:none}
*{box-sizing:border-box}
html{font-size:16px;height:100%}html[data-fs=l]{font-size:18px}html[data-fs=xl]{font-size:20px}
body{margin:0;min-height:100%;background:var(--bg);color:var(--tx);font-family:Nunito,system-ui,sans-serif;font-weight:700;-webkit-tap-highlight-color:transparent}
h1,h2,h3,.dsp{font-family:'Baloo 2',Nunito,sans-serif;font-weight:800;margin:0}
button{font:inherit;color:inherit;cursor:pointer;border:0;background:none}
button:focus-visible,input:focus-visible,select:focus-visible{outline:4px solid var(--fc);outline-offset:2px}
.hide{display:none!important}
header{position:sticky;top:0;z-index:30;background:var(--sf);border-bottom:3px solid var(--bd);padding:.6rem .9rem;display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;justify-content:space-between}
.logo{display:flex;align-items:center;gap:.6rem;text-align:left}
.logo i{width:2.8rem;height:2.8rem;border-radius:1rem;background:var(--br);display:grid;place-items:center;font-style:normal;font-size:1.6rem;color:var(--brt);font-family:'Baloo 2';font-weight:800;animation:wob 4s ease-in-out infinite}
.logo b{display:block;font-family:'Baloo 2';font-size:1.45rem;color:var(--br);line-height:1}
.logo small{color:var(--tx2);font-size:.75rem}
.bar{display:flex;gap:.45rem;flex-wrap:wrap}
.pill{background:var(--sf2);border:2px solid var(--bd);border-radius:1rem;padding:.55rem .8rem;font-size:.85rem;display:flex;gap:.35rem;align-items:center;transition:transform .12s}
.pill:active{transform:scale(.93)}
.sos{background:#DC2626;color:#fff;border-color:#991B1B;font-weight:800}
.big{background:var(--br);color:var(--brt);border-radius:1.4rem;padding:1rem 1.6rem;font-family:'Baloo 2';font-size:1.3rem;box-shadow:var(--sh);transition:transform .12s}
.big:active{transform:translateY(4px)}
.wrap{max-width:1100px;margin:0 auto;padding:1rem}
.hero{position:relative;overflow:hidden;background:var(--sf);border:3px solid var(--bd);border-radius:2rem;padding:1.6rem;display:grid;gap:1.4rem;grid-template-columns:1fr;box-shadow:var(--sh)}
@media(min-width:800px){.hero{grid-template-columns:1.3fr 1fr;padding:2.4rem}}
.hero h1{font-size:clamp(2.2rem,6vw,3.8rem);line-height:1}
.hero h1 em{display:block;font-style:normal;color:var(--br);font-size:.5em;margin-top:.5rem}
.hero p{color:var(--tx2);font-size:1.05rem;line-height:1.5}
.demo{background:var(--sf2);border:3px dashed var(--bd);border-radius:1.6rem;padding:1rem;display:grid;gap:.7rem;align-content:center}
.row3{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem}
.steps{display:grid;gap:1rem;margin-top:1rem}@media(min-width:800px){.steps{grid-template-columns:repeat(3,1fr)}}
.step{background:var(--sf);border:3px solid var(--bd);border-radius:1.6rem;padding:1.1rem;display:flex;gap:.8rem}
.step span{font-size:2.2rem}
.step p{margin:.2rem 0 0;color:var(--tx2);font-size:.9rem;line-height:1.4}
.fl{position:absolute;font-size:2rem;opacity:.35;animation:fly 9s ease-in-out infinite;pointer-events:none}
.strip{background:var(--sf);border:3px solid var(--br);border-radius:1.6rem;padding:.7rem;display:grid;gap:.6rem;position:sticky;top:4.6rem;z-index:20;box-shadow:var(--sh)}
@media(min-width:800px){.strip{grid-template-columns:1fr auto}}
#sent{min-height:6.2rem;background:var(--sf2);border:3px dashed var(--bd);border-radius:1.2rem;padding:.5rem;display:flex;gap:.5rem;align-items:center;overflow-x:auto}
#sent .ph{color:var(--tx2);margin:auto;text-align:center;font-size:.95rem}
.chip{flex:0 0 auto;display:flex;flex-direction:column;align-items:center;min-width:4.4rem;padding:.35rem .5rem;border-radius:1rem;border:3px solid var(--c);background:color-mix(in srgb,var(--c) 25%,var(--sf));animation:pop .3s}
.chip .em{font-size:2rem;line-height:1}.chip .em img{width:2.4rem;height:2.4rem;border-radius:.6rem;object-fit:cover}.chip span{font-size:.8rem}
.ctl{display:grid;grid-template-columns:repeat(2,1fr);gap:.45rem;min-width:15rem}
.ctl button{border-radius:1rem;padding:.65rem;font-size:.9rem}
.listen{grid-column:1/-1;background:#059669;color:#fff;font-family:'Baloo 2';font-size:1.3rem;box-shadow:0 5px 0 #065F46}
.listen:active{transform:translateY(4px)}
.tabs{display:flex;gap:.5rem;overflow-x:auto;padding:.8rem .1rem}
.tab{flex:0 0 auto;border-radius:1.2rem;padding:.6rem 1rem;border:3px solid var(--c);background:var(--sf);display:flex;gap:.4rem;align-items:center;transition:transform .12s}
.tab[aria-selected=true]{background:var(--c);color:#111;transform:translateY(-3px) scale(1.05);box-shadow:0 5px 0 rgba(0,0,0,.2)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(7.4rem,1fr));gap:.8rem}
body[data-age=child] .grid{grid-template-columns:repeat(auto-fill,minmax(8.6rem,1fr))}
.card{position:relative;aspect-ratio:1;border-radius:1.6rem;border:4px solid var(--c);background:color-mix(in srgb,var(--c) 28%,var(--sf));display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.3rem;padding:.4rem;box-shadow:0 6px 0 color-mix(in srgb,var(--c) 70%,#000);transition:transform .12s,box-shadow .12s;user-select:none}
.card:hover{transform:translateY(-3px) rotate(-1deg)}
.card:active,.card.hit{transform:translateY(5px) scale(.94);box-shadow:0 1px 0 var(--c)}
.card .em{font-size:3.4rem;line-height:1}body[data-age=adult] .card .em{font-size:2.4rem}
.card .em img{width:4.2rem;height:4.2rem;border-radius:1rem;object-fit:cover}
.card .lb{font-size:1.05rem;text-align:center;line-height:1.1}body[data-age=adult] .card .lb{font-size:.9rem}
.card.add{border-style:dashed;background:var(--sf2)}
.card .rm{position:absolute;top:-.5rem;right:-.5rem;width:2rem;height:2rem;border-radius:50%;background:#DC2626;color:#fff;display:grid;place-items:center;font-size:1rem}
[data-theme=contrast] .card,[data-theme=contrast] .chip,[data-theme=contrast] .tab{background:#000!important;border-color:#FFEB00;color:#FFEB00}
[data-theme=contrast] .tab[aria-selected=true]{background:#FFEB00!important;color:#000}
dialog{border:4px solid var(--br);border-radius:1.8rem;background:var(--sf);color:var(--tx);padding:1.2rem;width:min(34rem,94vw);max-height:88vh}
dialog::backdrop{background:rgba(10,15,40,.6)}
dialog h2{margin-bottom:.7rem}
.opt{display:flex;flex-wrap:wrap;gap:.4rem;margin:.3rem 0 1rem}
.opt button,.lst button.sm{border:2px solid var(--bd);background:var(--sf2);border-radius:.9rem;padding:.5rem .8rem;font-size:.9rem}
.opt button[aria-pressed=true]{background:var(--br);color:var(--brt);border-color:var(--br)}
.lst{display:grid;gap:.5rem;margin:.5rem 0}
.it{display:flex;gap:.5rem;align-items:center;background:var(--sf2);border-radius:1rem;padding:.5rem .7rem}
.it .t{flex:1;text-align:left}
input[type=text]{width:100%;font:inherit;padding:.7rem;border-radius:.9rem;border:3px solid var(--bd);background:var(--sf);color:var(--tx)}
label{display:block;margin:.6rem 0 .25rem;font-size:.9rem;color:var(--tx2)}
#sos{position:fixed;inset:0;z-index:80;background:#B91C1C;color:#fff;display:grid;place-content:center;gap:1rem;padding:1rem;text-align:center;animation:flash 1s infinite;padding-top:env(safe-area-inset-top,1rem)}
#sos h2{font-size:clamp(2.4rem,9vw,5rem)}
#sos .bt{background:#fff;color:#7F1D1D;border-radius:1.6rem;padding:1.1rem 1.5rem;font-family:'Baloo 2';font-size:1.6rem;display:block;width:min(30rem,90vw);margin:auto}
#toast{position:fixed;left:50%;bottom:calc(1rem + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--br);color:var(--brt);padding:.6rem 1.1rem;border-radius:1rem;z-index:90;transition:opacity .3s}
.cf{position:fixed;font-size:1.8rem;pointer-events:none;z-index:70;animation:burst 1.1s ease-out forwards}
@keyframes pop{from{transform:scale(.3);opacity:0}to{transform:scale(1);opacity:1}}
@keyframes wob{0%,100%{transform:rotate(-6deg)}50%{transform:rotate(6deg)}}
@keyframes fly{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-26px) rotate(12deg)}}
@keyframes flash{0%,100%{background:#B91C1C}50%{background:#7F1D1D}}
@keyframes burst{to{transform:translate(var(--x),var(--y)) rotate(360deg);opacity:0}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body data-age="child">
<header>
 <button class="logo" onclick="go('home')" aria-label="Início do Conecta+"><i aria-hidden="true">C+</i><span><b>Conecta+</b><small>Minha comunicação, minha voz!</small></span></button>
 <div class="bar">
  <button class="pill" id="navb" onclick="go(cur=='home'?'board':'home')">🗣️ <span id="navt">Prancha</span></button>
  <button class="pill" onclick="dFav()" aria-label="Favoritas">⭐ Favoritas</button>
  <button class="pill" onclick="dHist()" aria-label="Histórico">🕒 Histórico</button>
  <button class="pill" onclick="dQR()" aria-label="QR Code">📱 QR</button>
  <button class="pill" onclick="dSet()" aria-label="Ajustes">⚙️ Ajustes</button>
  <button class="pill sos" onclick="sos()" aria-label="Emergência: preciso de ajuda">🚨 AJUDA</button>
 </div>
</header>

<main id="home" class="wrap">
 <section class="hero">
  <span class="fl" style="left:4%;top:6%">⭐</span><span class="fl" style="right:6%;top:8%;animation-delay:2s">🎈</span><span class="fl" style="left:48%;bottom:4%;animation-delay:4s">💬</span>
  <div>
   <h1>Conecta+<em>Minha comunicação, minha voz!</em></h1>
   <p>Prancha digital de <b>Comunicação Alternativa e Aumentativa</b> para dizer o que sente, precisa e pensa com símbolos, palavras e voz. Comunicar é um direito de todos.</p>
   <p style="display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1.2rem"><button class="big" onclick="go('board')">Abrir a prancha</button><button class="pill" onclick="dSet()">🎨 Personalizar</button></p>
   <div class="opt" style="margin-top:.8rem"><button class="pill" data-age="child" onclick="P.age='child';app()">🧸 Modo infantil</button><button class="pill" data-age="adult" onclick="P.age='adult';app()">💼 Modo adulto</button></div>
  </div>
  <div class="demo"><div class="row3" id="demo"></div><button class="big" style="background:#059669" onclick="say('Quero água, por favor')">🔊 Ouvir: “Quero água, por favor”</button></div>
 </section>
 <h2 style="margin:1.4rem 0 .2rem">Como usar</h2>
 <div class="steps">
  <div class="step"><span>👆</span><div><h3>Toque nos símbolos</h3><p>Cada toque fala a palavra em voz alta.</p></div></div>
  <div class="step"><span>🧩</span><div><h3>Monte a frase</h3><p>Os cartões ficam na faixa de cima. Toque num cartão da faixa para tirá-lo.</p></div></div>
  <div class="step"><span>🔊</span><div><h3>Ouça tudo junto</h3><p>Aperte o botão verde para falar a frase completa.</p></div></div>
 </div>
</main>

<main id="board" class="wrap hide">
 <section class="strip" aria-label="Frase montada">
  <div id="sent" aria-live="polite"></div>
  <div class="ctl">
   <button class="listen" onclick="speakSent()" aria-label="Ouvir a frase completa">🔊 OUVIR</button>
   <button class="pill" style="background:#FDE68A;color:#451A03" onclick="S.pop();rs()">⌫ Apagar</button>
   <button class="pill" style="background:#FECDD3;color:#4C0519" onclick="S=[];rs()">🗑️ Limpar</button>
   <button class="pill" style="grid-column:1/-1" onclick="favAdd()">⭐ Salvar nas favoritas</button>
  </div>
 </section>
 <div class="tabs" role="tablist" id="tabs" aria-label="Categorias"></div>
 <div class="opt" style="margin:0 0 .6rem"><button class="pill" id="edb" onclick="P.edit=!P.edit;sv('cm_p',P);rc()" aria-pressed="false">✏️ Editar prancha</button></div>
 <div class="grid" id="grid"></div>
</main>

<dialog id="dlg"><div id="db"></div><p style="text-align:right;margin:.8rem 0 0"><button class="big" style="padding:.5rem 1.2rem;font-size:1.05rem" onclick="dlg.close()">Fechar</button></p></dialog>
<div id="sos" class="hide" role="alertdialog" aria-label="Pedido de ajuda"></div>
<div id="toast" class="hide" role="status"></div>

<script>
const ld=(k,d)=>{try{const v=JSON.parse(localStorage.getItem(k));return v==null?d:v}catch(e){return d}};
const sv=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}};
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const $=id=>document.getElementById(id);
const dlg=$('dlg');
const DEF=[
['Sentimentos','😊','#F472B6',[['Feliz','😄'],['Triste','😢'],['Bravo','😠'],['Com medo','😨'],['Ansioso','😰'],['Cansado','😩'],['Com sono','😴'],['Com dor','🤕'],['Animado','🤩'],['Estou bem','👍']]],
['Necessidades','🆘','#38BDF8',[['Água','💧'],['Comida','🍽️'],['Banheiro','🚽'],['Ajuda','🆘'],['Descansar','🛋️'],['Dormir','🛏️'],['Tomar banho','🚿'],['Estou com frio','🥶'],['Estou com calor','🥵'],['Estou com dor','🤕']]],
['Alimentação','🍎','#FB923C',[['Água','💧'],['Suco','🧃'],['Leite','🥛'],['Frutas','🍎'],['Arroz','🍚'],['Feijão','🫘'],['Pão','🍞'],['Quero comer','😋'],['Não quero comer','🙅']]],
['Pessoas','👨‍👩‍👧','#A78BFA',[['Mãe','👩'],['Pai','👨'],['Professor','🧑‍🏫'],['Amigo','🧑‍🤝‍🧑'],['Família','👨‍👩‍👧'],['Médico','🧑‍⚕️'],['Cuidador','🤝']]],
['Ações','🧸','#34D399',[['Brincar','🧸'],['Estudar','📚'],['Passear','🚶'],['Conversar','💬'],['Desenhar','🎨'],['Assistir','📺'],['Ouvir música','🎧'],['Descansar','🛋️'],['Ler','📖'],['Ir embora','🚪']]],
['Expressões','💬','#FACC15',[['Sim','✅'],['Não','❌'],['Quero','🙋'],['Não quero','🚫'],['Gosto','👍'],['Não gosto','👎'],['Obrigado','🙏'],['Por favor','🥺'],['Desculpa','😔'],['Preciso de ajuda','🆘'],['Acabou','🏁'],['Mais','➕'],['De novo','🔁']]]
].map(c=>({n:c[0],e:c[1],c:c[2],i:c[3].map(x=>({t:x[0],e:x[1]}))}));
let P=Object.assign({theme:'auto',age:'child',fs:'n',rate:0.9,tap:true,cat:0,edit:false},ld('cm_p',{}));
let CATS=ld('cm_c',null)||JSON.parse(JSON.stringify(DEF));
let S=[],FAV=ld('cm_f',[]),HIS=ld('cm_h',[]),cur='home',ED=null;

function app(){
 const r=document.documentElement;
 P.theme=='auto'?r.removeAttribute('data-theme'):r.setAttribute('data-theme',P.theme);
 r.setAttribute('data-fs',P.fs);document.body.dataset.age=P.age;
 document.querySelectorAll('[data-age]').forEach(b=>{if(b.tagName=='BUTTON')b.setAttribute('aria-pressed',b.dataset.age==P.age)});
 sv('cm_p',P);rc();rs();
}
function voice(){const v=speechSynthesis.getVoices();return v.find(x=>x.lang=='pt-BR')||v.find(x=>x.lang&&x.lang.startsWith('pt'))||null}
function say(t,after){
 if(!('speechSynthesis' in window)||typeof SpeechSynthesisUtterance=='undefined'){toast('Este navegador não tem voz. Tente o Chrome ou o Edge.');return}
 try{speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(t);u.lang='pt-BR';u.rate=P.rate;u.pitch=1.05;const v=voice();if(v)u.voice=v;if(after)u.onend=after;speechSynthesis.speak(u)}catch(e){}
}
if('speechSynthesis' in window)speechSynthesis.onvoiceschanged=()=>{};
function toast(m){const t=$('toast');t.textContent=m;t.classList.remove('hide');t.style.opacity=1;clearTimeout(toast.h);toast.h=setTimeout(()=>{t.style.opacity=0;setTimeout(()=>t.classList.add('hide'),300)},2200)}
function confetti(x,y){['⭐','🎉','💙','✨','🎈','🌈'].forEach((e,i)=>{const s=document.createElement('span');s.className='cf';s.textContent=e;s.style.left=x+'px';s.style.top=y+'px';const a=i/6*6.28;s.style.setProperty('--x',Math.cos(a)*90+'px');s.style.setProperty('--y',Math.sin(a)*90-40+'px');document.body.appendChild(s);setTimeout(()=>s.remove(),1100)})}

function go(v){cur=v;$('home').classList.toggle('hide',v!='home');$('board').classList.toggle('hide',v!='board');$('navt').textContent=v=='home'?'Prancha':'Início';window.scrollTo(0,0);try{if(location.hash.slice(1)!=v)history.replaceState(null,'','#'+v)}catch(e){}}
function rc(){
 const tb=$('tabs');tb.innerHTML=CATS.map((c,i)=>`<button role="tab" class="tab" style="--c:${c.c}" aria-selected="${i==P.cat}" onclick="P.cat=${i};sv('cm_p',P);rc();say('${esc(c.n)}')"><span aria-hidden="true">${c.e}</span>${esc(c.n)}</button>`).join('');
 const c=CATS[P.cat]||CATS[0];
 $('grid').innerHTML=c.i.map((x,i)=>`<div style="position:relative"><button class="card" style="--c:${c.c}" onclick="tap(${i},event)" aria-label="${esc(x.t)}"><span class="em" aria-hidden="true">${x.g?`<img src="${x.g}" alt="">`:esc(x.e)}</span><span class="lb">${esc(x.t)}</span></button>${P.edit?`<button class="rm" onclick="delC(${i})" aria-label="Remover ${esc(x.t)}">✕</button>`:''}</div>`).join('')+(P.edit?`<button class="card add" style="--c:${c.c}" onclick="dEdit(-1)" aria-label="Adicionar símbolo"><span class="em">➕</span><span class="lb">Novo</span></button>`:'');
 $('edb').setAttribute('aria-pressed',P.edit);$('edb').textContent=P.edit?'✅ Terminar edição':'✏️ Editar prancha';
}
function tap(i,ev){
 const x=CATS[P.cat].i[i];
 if(P.edit){dEdit(i);return}
 S.push({t:x.t,e:x.e,g:x.g,c:CATS[P.cat].c});rs();
 if(P.tap)say(x.t);
 const b=ev.currentTarget;b.classList.add('hit');setTimeout(()=>b.classList.remove('hit'),160);
 const r=b.getBoundingClientRect();confetti(r.left+r.width/2,r.top+r.height/2);
}
function rs(){
 const s=$('sent');
 s.innerHTML=S.length?S.map((x,i)=>`<button class="chip" style="--c:${x.c}" onclick="S.splice(${i},1);rs()" aria-label="Remover ${esc(x.t)}"><span class="em">${x.g?`<img src="${x.g}" alt="">`:esc(x.e)}</span><span>${esc(x.t)}</span></button>`).join(''):'<div class="ph">Toque nos cartões para montar sua frase 👇</div>';
 s.scrollLeft=s.scrollWidth;
}
function speakSent(){
 if(!S.length){say('Toque nos cartões para montar uma frase');return}
 const t=S.map(x=>x.t).join(' ');say(t);
 if(HIS[0]?.t!=t){HIS.unshift({t,d:new Date().toLocaleString('pt-BR')});HIS=HIS.slice(0,40);sv('cm_h',HIS)}
 confetti(innerWidth/2,innerHeight/3);
}
function favAdd(){
 if(!S.length){say('Monte uma frase primeiro');return}
 const t=S.map(x=>x.t).join(' ');
 if(!FAV.includes(t)){FAV.push(t);sv('cm_f',FAV)}toast('⭐ Salva nas favoritas');say('Frase salva');
}
function delC(i){CATS[P.cat].i.splice(i,1);sv('cm_c',CATS);rc();say('Removido')}

function openD(h){$('db').innerHTML=h;if(!dlg.open)dlg.showModal()}
function dFav(){
 openD(`<h2>⭐ Mensagens favoritas</h2><div class="lst">${FAV.length?FAV.map((t,i)=>`<div class="it"><button class="t" onclick="say(FAV[${i}])">🔊 ${esc(t)}</button><button class="sm" onclick="FAV.splice(${i},1);sv('cm_f',FAV);dFav()" aria-label="Apagar">🗑️</button></div>`).join(''):'<p>Nenhuma ainda. Monte uma frase e toque em “Salvar nas favoritas”.</p>'}</div>`);
}
function dHist(){
 openD(`<h2>🕒 Histórico</h2><div class="lst">${HIS.length?HIS.map((h,i)=>`<div class="it"><button class="t" onclick="say(HIS[${i}].t)">🔊 ${esc(h.t)}<br><small style="color:var(--tx2)">${esc(h.d)}</small></button><button class="sm" onclick="HIS.splice(${i},1);sv('cm_h',HIS);dHist()" aria-label="Apagar">🗑️</button></div>`).join(''):'<p>Nenhuma frase falada ainda.</p>'}</div>${HIS.length?'<button class="pill" onclick="HIS=[];sv(\'cm_h\',HIS);dHist()">🗑️ Apagar tudo</button>':''}`);
}
function dQR(){
 openD(`<h2>📱 QR Code de acesso</h2><p style="color:var(--tx2)">Aponte a câmera do celular para abrir o Conecta+.</p><div id="qr" style="background:#fff;padding:12px;border-radius:1rem;width:fit-content;margin:auto"></div>`);
 try{new QRCode($('qr'),{text:location.href.split('#')[0],width:200,height:200})}catch(e){$('qr').textContent='QR indisponível sem internet.'}
}
function seg(k,vals){return `<div class="opt">${vals.map(v=>`<button aria-pressed="${P[k]==v[0]}" onclick="P.${k}='${v[0]}';app();dSet()">${v[1]}</button>`).join('')}</div>`}
function dSet(){
 openD(`<h2>⚙️ Ajustes</h2><label>Tema</label>${seg('theme',[['auto','🖥️ Automático'],['light','☀️ Claro'],['dark','🌙 Noturno'],['contrast','🟡 Alto contraste']])}
 <label>Modo</label>${seg('age',[['child','🧸 Infantil'],['adult','💼 Adulto']])}
 <label>Tamanho do texto</label>${seg('fs',[['n','Normal'],['l','Grande'],['xl','Muito grande']])}
 <label>Velocidade da voz</label><input type="range" min="0.5" max="1.4" step="0.1" value="${P.rate}" style="width:100%" oninput="P.rate=+this.value;sv('cm_p',P)" onchange="say('Esta é a velocidade da voz')">
 <label>Falar a cada toque</label><div class="opt"><button aria-pressed="${P.tap}" onclick="P.tap=!P.tap;sv('cm_p',P);dSet()">${P.tap?'🔊 Ligado':'🔇 Desligado'}</button></div>
 <button class="pill" onclick="dReset()">♻️ Restaurar prancha original</button>`);
}
function dReset(){
 openD(`<h2>♻️ Restaurar prancha?</h2><p>Os símbolos voltam ao original e suas edições serão perdidas.</p><div class="opt"><button class="pill" onclick="CATS=JSON.parse(JSON.stringify(DEF));sv('cm_c',null);P.cat=0;rc();dlg.close();say('Prancha restaurada')">Sim, restaurar</button><button class="pill" onclick="dSet()">Não, voltar</button></div>`);
}
function dEdit(i){
 const c=CATS[P.cat];ED={i,g:i>=0?c.i[i].g:null};const x=i>=0?c.i[i]:{t:'',e:'⭐'};
 openD(`<h2>${i>=0?'Editar':'Novo'} símbolo</h2><label for="et">Palavra ou frase</label><input type="text" id="et" value="${esc(x.t)}"><label for="ee">Emoji</label><input type="text" id="ee" value="${esc(x.e)}" maxlength="6"><label for="ef">Ou use uma foto (pessoa, familiar, objeto)</label><input type="file" id="ef" accept="image/*" onchange="photo(this)"><p id="ep" style="margin:.4rem 0">${ED.g?`<img src="${ED.g}" alt="" style="width:4rem;border-radius:1rem">`:''}</p><button class="big" style="font-size:1.1rem;padding:.6rem 1.2rem" onclick="saveEd()">Salvar</button>`);
}
function photo(el){
 const f=el.files[0];if(!f)return;const r=new FileReader();
 r.onload=()=>{const im=new Image();im.onload=()=>{const k=Math.min(1,160/Math.max(im.width,im.height)),cv=document.createElement('canvas');cv.width=im.width*k;cv.height=im.height*k;cv.getContext('2d').drawImage(im,0,0,cv.width,cv.height);ED.g=cv.toDataURL('image/jpeg',.7);$('ep').innerHTML=`<img src="${ED.g}" alt="" style="width:4rem;border-radius:1rem">`};im.src=r.result};r.readAsDataURL(f);
}
function saveEd(){
 const t=$('et').value.trim();if(!t){toast('Escreva uma palavra');return}
 const o={t,e:$('ee').value.trim()||'⭐'};if(ED.g)o.g=ED.g;
 const l=CATS[P.cat].i;ED.i>=0?l[ED.i]=o:l.push(o);sv('cm_c',CATS);rc();dlg.close();say(t);
}
let sosT;
function sos(){
 const o=$('sos');o.classList.remove('hide');
 o.innerHTML=`<h2 class="dsp">🚨 PRECISO DE AJUDA!</h2><button class="bt" onclick="say('Preciso de ajuda agora!')">🆘 Preciso de ajuda</button><button class="bt" onclick="say('Estou com dor')">🤕 Estou com dor</button><button class="bt" onclick="say('Estou me sentindo mal')">😣 Estou mal</button><button class="bt" onclick="say('Por favor, chame alguém')">📞 Chamar alguém</button><button class="bt" style="background:transparent;color:#fff;border:3px solid #fff;font-size:1.2rem" onclick="closeSos()">Fechar</button>`;
 const rep=()=>say('Atenção! Preciso de ajuda!');rep();sosT=setInterval(rep,6000);
}
function closeSos(){clearInterval(sosT);speechSynthesis.cancel();$('sos').classList.add('hide')}
document.addEventListener('keydown',e=>{if(e.key=='Escape'&&!$('sos').classList.contains('hide'))closeSos()});
$('demo').innerHTML=[['Quero','🙋','#F472B6'],['Água','💧','#38BDF8'],['Por favor','🙏','#FACC15']].map(d=>`<button class="card" style="--c:${d[2]}" onclick="say('${d[0]}')"><span class="em">${d[1]}</span><span class="lb">${d[0]}</span></button>`).join('');
app();go(location.hash=='#board'?'board':'home');
</script>
</body>
</html>
